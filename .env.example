# Development environment variables
ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DATABASE_URL=postgresql://techno:password@localhost:5432/techno_re?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your-dev-secret-key-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
JWT_ISSUER=techno-re-ecosystem
JWT_AUDIENCE=techno-re-users

# Cache (Redis)
CACHE_ENABLED=true
REDIS_ADDR=localhost:6379
CACHE_DEFAULT_TTL=1h
CACHE_MAX_RETRIES=3

# Mining Configuration
MINING_REWARD_PER_FACT=10.5
MINING_MIN_SESSION_DURATION=5m
MINING_MAX_CPU_PERCENT=50
MINING_CONSENSUS_THRESHOLD=0.8

# Email Service (disabled by default)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDR=noreply@techno-re.io

# S3 Configuration (disabled by default)
S3_ENABLED=false
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=techno-re-bucket
S3_ENDPOINT=

# Server Timeouts
SHUTDOWN_TIMEOUT=30s
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
